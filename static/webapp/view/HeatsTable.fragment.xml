<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

  <Table id="heatsTable" autoPopinMode="true" items="{heats>/}" growing="true" growingScrollToLoad="true" growingThreshold="30"
    mode="SingleSelectMaster" itemPress=".onItemPress" sticky="HeaderToolbar,InfoToolbar,ColumnHeaders" class="sapUiNoContentPadding">

    <!-- The HeaderToolbar shows a title and the filter button -->
    <headerToolbar>
      <OverflowToolbar>
        <content>
          <SearchField width="10rem" liveChange=".onSearchFieldLiveChange" showSearchButton="false" />
          <!-- Filter button -->
          <Button text="{=!${device>/system/phone}?${i18n>common.filter}:''}" tooltip="{i18n>common.filter}" icon="sap-icon://filter"
            press=".onFilterButtonPress" />
          <!-- Sorting button -->
          <Button text="{=!${device>/system/phone}?${i18n>common.sorting}:''}" tooltip="{i18n>common.sorting}" icon="sap-icon://sort"
            press=".onSortButtonPress" />
          <ToolbarSpacer />
          <!-- Refresh button -->
          <Button text="{=!${device>/system/phone}?${i18n>common.refresh}:''}" tooltip="{i18n>common.refresh}" icon="sap-icon://refresh"
            press=".onRefreshButtonPress" />
        </content>
      </OverflowToolbar>
    </headerToolbar>

    <!-- The InfoToolbar shows active filters -->
    <infoToolbar>
      <OverflowToolbar visible="false">
        <content>
          <Text />
          <ToolbarSpacer />
          <Button tooltip="{i18n>common.clearFilters}" icon="sap-icon://clear-filter" press=".onClearFilterPress" type="Transparent" />
        </content>
      </OverflowToolbar>
    </infoToolbar>

    <columns>
      <Column id="heatDateTime" hAlign="Center" width="5rem" importance="High" popinDisplay="Inline">
        <header>
          <Text text="{i18n>common.time}" />
        </header>
      </Column>
      <Column id="heat" width="auto" importance="High" popinDisplay="Inline">
        <header>
          <Text text="{i18n>common.heat}" />
        </header>
      </Column>
      <Column id="heatDistance" hAlign="Center" width="6rem" importance="Medium" popinDisplay="Inline" visible="{=!${device>/system/phone}}">
        <header>
          <Text text="{i18n>common.distance}" />
        </header>
      </Column>
      <Column id="heatNr" hAlign="Center" width="5rem" importance="Low" popinDisplay="Inline" visible="{=!${device>/system/phone}}">
        <header>
          <Text text="{i18n>common.heatNr}" />
        </header>
      </Column>
      <Column hAlign="Center" width="6rem" importance="Low" popinDisplay="Inline" visible="{=!${device>/system/phone}}">
        <header>
          <Text text="{i18n>common.seeded}" />
        </header>
      </Column>
      <Column id="heatState" hAlign="Center" width="5rem" importance="Low" popinDisplay="Inline">
        <header>
          <Text text="{i18n>common.state}" />
        </header>
      </Column>
    </columns>

    <items>
      <ColumnListItem type="Navigation" highlight="{path:'heats>',formatter:'.formatter.heatStateHighlight'}">
        <!-- CustomData writes data-cancelled="true/false" as a DOM attribute on the row element.
             The CSS rule [data-cancelled="true"] .sapMText then applies strikethrough to all Text cells.
             (The class attribute is not a ManagedObject property so it cannot be bound reactively.) -->
        <customData>
          <core:CustomData key="cancelled" value="{=${heats>cancelled}?'true':'false'}" writeToDom="true" />
        </customData>
        <cells>
          <Text text="{path:'heats>dateTime',formatter:'.formatter.dayTimeIsoLabel'}" />

          <VBox>
            <Text text="{path:'heats>race',formatter:'.formatter.nrRaceLabel'}, {path:'heats>',formatter:'.formatter.heatLabel'}"
              class="bold" />
            <Text text="{heats>race/longLabel} {heats>race/comment}" visible="{=!${device>/system/phone}}" />
          </VBox>

          <Text text="{path:'heats>race',formatter:'.formatter.distanceLabel'}" />

          <Text text="{heats>number}" />

          <Text text="{=${heats>race/seeded}?${i18n>common.yes}:${i18n>common.no}}" />

          <ObjectStatus text="{path:'heats>',formatter:'.formatter.heatStateLabel'}"
            state="{path:'heats>',formatter:'.formatter.heatStateHighlight'}" class="bold" />
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>