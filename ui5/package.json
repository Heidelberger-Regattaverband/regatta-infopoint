{
  "name": "infoportal",
  "version": "0.1.0",
  "scripts": {
    "build": "ui5 build --clean-dest",
    "build:opt": "ui5 build self-contained --clean-dest --all",
    "ts-typecheck": "tsc --noEmit",
    "lint": "npm run lint:ui5 && npm run lint:ts",
    "lint:ui5": "ui5lint",
    "lint:ts": "eslint \"webapp/**/*.{ts,js}\" \"test/**/*.mjs\"",
    "lint:strict": "npm run lint:ui5 && npm run lint:ts -- --max-warnings=0",
    "lint:fix": "npm run lint:ts -- --fix",
    "format": "prettier --write \"webapp/**/*.{ts,js,xml,json,css,html}\" \"test/**/*.mjs\" \"*.{json,yaml,mjs,md}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"webapp/**/*.{ts,js,xml,json,css,html}\" \"test/**/*.mjs\" \"*.{json,yaml,mjs,md}\" \".prettierrc.json\"",
    "check": "npm run ts-typecheck && npm run lint && npm run format:check",
    "test:async": "node --test test/async-callbacks.test.mjs",
    "watch": "watch 'npm run build' webapp"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openui5/types": "^1.154.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/leaflet": "^1.9.22",
    "@ui5/cli": "^4.1.0",
    "@ui5/linter": "^1.23.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "ui5-tooling-modules": "^3.43.2",
    "ui5-tooling-transpile": "^3.14.1",
    "watch": "^1.0.2"
  },
  "private": true,
  "allowScripts": {
    "fsevents@2.3.3": true,
    "ui5-tooling-modules@3.43.2": true,
    "ui5-tooling-transpile@3.14.1": true
  }
}
