<mvc:View
  controllerName="de.regatta_hd.infoportal.controller.Notifications"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:layout="sap.ui.layout"
>
  <mvc:content>

    <Page title="{i18n>notifications.title}" showNavButton="true" navButtonPress=".navBack">
      <content>
        <Table
          id="notificationsTable"
          items="{notifications>/}"
          growing="true"
          growingThreshold="50"
          sticky="HeaderToolbar,ColumnHeaders"
          autoPopinMode="true"
        >
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{i18n>notifications.title}" />
              <ToolbarSpacer />
              <Button
                icon="sap-icon://add"
                text="{=!${device>/system/phone}?${i18n>common.add}:''}"
                tooltip="{i18n>common.add}"
                press=".onAddNotification"
              />
              <Button
                icon="sap-icon://refresh"
                text="{=!${device>/system/phone}?${i18n>common.refresh}:''}"
                tooltip="{i18n>common.refresh}"
                press=".onRefresh"
              />
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column importance="Medium" popinDisplay="Inline">
              <Text text="{i18n>common.title}" />
            </Column>
            <Column hAlign="Center" width="7rem" importance="Low" popinDisplay="Inline">
              <Text text="{i18n>notifications.column.priority}" />
            </Column>
            <Column hAlign="Center" width="5rem" importance="Medium" popinDisplay="Inline">
              <Text text="{i18n>notifications.column.visible}" />
            </Column>
            <Column hAlign="Center" width="9rem" importance="Low" popinDisplay="Inline">
              <Text text="{i18n>notifications.column.modifiedAt}" />
            </Column>
            <Column hAlign="Center" width="5rem" importance="Low" popinDisplay="Inline">
              <Text text="{i18n>common.actions}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{notifications>title}" />
                <ComboBox selectedKey="{notifications>priority}" selectionChange=".onPriorityChange">
                  <core:Item key="0" text="{i18n>notifications.priority.none}" />
                  <core:Item key="1" text="{i18n>notifications.priority.low}" />
                  <core:Item key="2" text="{i18n>notifications.priority.medium}" />
                  <core:Item key="3" text="{i18n>notifications.priority.high}" />
                </ComboBox>
                <Switch state="{notifications>visible}" change=".onVisibilityChange" />
                <Text text="{path:'notifications>modifiedAt',formatter:'.formatter.dateTime'}" />
                <HBox>
                  <Button
                    icon="sap-icon://edit"
                    press=".onEditNotification"
                    tooltip="{i18n>common.edit}"
                    type="Default"
                  />
                  <Button
                    icon="sap-icon://delete"
                    press=".onDeleteNotification"
                    tooltip="{i18n>common.delete}"
                    type="Reject"
                  />
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>

    <!-- Add/Edit Notification Dialog -->
    <Dialog id="notificationDialog" title="{i18n>notifications.dialog.title}">
      <content>
        <VBox class="sapUiSmallMargin">
          <Label text="{i18n>common.title}" required="true" />
          <Input id="titleInput" value="{dialog>/title}" placeholder="{i18n>notifications.dialog.title.placeholder}" />

          <Label text="{i18n>notifications.dialog.text.label}" />
          <TextArea
            id="textInput"
            value="{dialog>/text}"
            placeholder="{i18n>notifications.dialog.text.placeholder}"
            rows="4"
            width="100%"
          />

          <Label text="{i18n>notifications.dialog.priority.label}" />
          <Select id="prioritySelect" selectedKey="{dialog>/priority}">
            <core:Item key="0" text="{i18n>notifications.priority.none}" />
            <core:Item key="1" text="{i18n>notifications.priority.low}" />
            <core:Item key="2" text="{i18n>notifications.priority.medium}" />
            <core:Item key="3" text="{i18n>notifications.priority.high}" />
          </Select>

          <CheckBox
            id="visibleCheckBox"
            text="{i18n>notifications.dialog.visible.label}"
            selected="{dialog>/visible}"
          />
        </VBox>
      </content>
      <beginButton>
        <Button text="{i18n>common.save}" press=".onSaveNotification" type="Emphasized" />
      </beginButton>
      <endButton>
        <Button text="{i18n>common.cancel}" press=".onCancelDialog" />
      </endButton>
    </Dialog>

  </mvc:content>
</mvc:View>
